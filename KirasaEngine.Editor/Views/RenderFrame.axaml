<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KirasaEngine.Editor.ViewModels"
             xmlns:local="using:KirasaEngine.Editor.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KirasaEngine.Editor.Views.RenderFrame">
    <Grid>
        <Border >
            <Image 
                x:Name="FrameContent" 
                Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                RenderOptions.BitmapInterpolationMode="None"
                SizeChanged="FrameContent_OnSizeChanged">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="-1"/>
                </Image.RenderTransform>
            </Image>
        </Border>
    </Grid>
</UserControl>
